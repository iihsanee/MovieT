@model List<MovieT.ViewModels.SerieViewModel>
@using serviceLibary.Models
@{
    var genres = ViewBag.Genres as List<GenreModel> ?? new List<GenreModel>();
}

<div style="padding: 30px 20px 80px 20px;">
    <h1 style="font-size: 2rem; font-weight: 800; color: #fff; margin-bottom: 24px;">📺 Series</h1>

    <div style="display: flex; gap: 12px; margin-bottom: 30px; flex-wrap: wrap;">
        <form method="get" asp-action="Search" style="display: flex; gap: 8px;">
            <input type="text" name="query" placeholder="Zoek een serie..."
                   style="background: #2a2a2a; border: 1px solid #444; color: #fff; padding: 10px 16px; border-radius: 6px; width: 260px;" />
            <button type="submit"
                    style="background: #E50914; color: #fff; border: none; padding: 10px 20px; border-radius: 6px; font-weight: 600; cursor: pointer;">
                Zoeken
            </button>
        </form>

        <form method="get" asp-action="Index" style="display: flex; gap: 8px;">
            <select name="genreId"
                    style="background: #2a2a2a; border: 1px solid #444; color: #fff; padding: 10px 14px; border-radius: 6px;">
                <option value="">Alle genres</option>
                @foreach (var genre in genres)
                {
                    if (ViewBag.SelectedGenre == genre.Id)
                    {
                        <option value="@genre.Id" selected>@genre.Naam</option>
                    }
                    else
                    {
                        <option value="@genre.Id">@genre.Naam</option>
                    }
                }
            </select>
            <button type="submit"
                    style="background: #2a2a2a; color: #fff; border: 1px solid #444; padding: 10px 20px; border-radius: 6px; font-weight: 600; cursor: pointer;">
                Filter
            </button>
        </form>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px;">
        @foreach (var serie in Model)
        {
            <div style="background: #1f1f1f; border: 1px solid #333; border-radius: 10px; padding: 20px; transition: transform 0.2s;"
                 onmouseover="this.style.transform='scale(1.02)'; this.style.borderColor='#E50914';"
                 onmouseout="this.style.transform='scale(1)'; this.style.borderColor='#333';">

                <div style="font-size: 1.1rem; font-weight: 700; color: #fff; margin-bottom: 6px;">
                    @serie.Title
                </div>
                <div style="font-size: 0.8rem; color: #B3B3B3; margin-bottom: 16px;">
                    🎭 @string.Join(", ", serie.Genres)
                </div>

                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <a asp-action="Details" asp-route-id="@serie.Id"
                       style="background: #2a2a2a; color: #fff; padding: 8px 14px; border-radius: 6px; font-size: 0.85rem; text-align: center; border: 1px solid #444;">
                        📄 Details
                    </a>
                    <a asp-controller="WatchingList" asp-action="AddSerie"
                       asp-route-userId="1"
                       asp-route-serieId="@serie.Id"
                       asp-route-title="@serie.Title"
                       style="background: #2a2a2a; color: #fff; padding: 8px 14px; border-radius: 6px; font-size: 0.85rem; text-align: center; border: 1px solid #444;">
                        👁 Watching List
                    </a>
                    <a asp-controller="WatchedList" asp-action="Add"
                       asp-route-serieId="@serie.Id"
                       asp-route-title="@serie.Title"
                       asp-route-type="Serie"
                       style="background: #E50914; color: #fff; padding: 8px 14px; border-radius: 6px; font-size: 0.85rem; text-align: center; font-weight: 600;">
                        ✅ Watched List
                    </a>
                </div>
            </div>
        }
    </div>
</div>