@model MovieT.ViewModels.UserViewModel
@if (TempData["Melding"] != null)
{
    <p style="color:green">@TempData["Melding"]</p>
}
@if (TempData["Foutmelding"] != null)
{
    <p style="color:red">@TempData["Foutmelding"]</p>
}
@if (TempData["Fout"] != null)
{
    <p style="color:red">@TempData["Fout"]</p>
}
@if (TempData["Succes"] != null)
{
    <p style="color:green">@TempData["Succes"]</p>
}
<h2>Inloggen</h2>
<form asp-action="Login" method="post">
    <div>
        <label>E-mailadres</label>
        <input name="email" type="email" />
    </div>
    <div>
        <label>Wachtwoord</label>
        <input name="wachtwoord" type="password" />
    </div>
    <button type="submit">Inloggen</button>
</form>
<a href="@Url.Action("WachtwoordVergeten", "User")">Wachtwoord vergeten?</a>