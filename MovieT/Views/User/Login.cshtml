@if (TempData["Fout"] != null)
{
    <p style="color: #E50914; margin-bottom: 12px;">@TempData["Fout"]</p>
}

<div style="display: flex; justify-content: center; align-items: center; min-height: 70vh;">
    <div style="background: #1f1f1f; border: 1px solid #333; border-radius: 12px; padding: 40px; width: 100%; max-width: 420px;">
        <h2 style="color: #fff; font-weight: 800; margin-bottom: 24px; text-align: center;">Inloggen</h2>

        <form asp-action="Login" method="post" style="display: flex; flex-direction: column; gap: 16px;"
              onsubmit="return valideerLogin()">
            <div>
                <label style="color: #B3B3B3; font-size: 0.85rem; margin-bottom: 6px; display: block;">E-mailadres</label>
                <input type="email" id="email" name="email" placeholder="jouw@email.nl"
                       style="width: 100%; background: #2a2a2a; border: 1px solid #444; color: #fff; padding: 12px 14px; border-radius: 6px; box-sizing: border-box;" />
            </div>
            <div>
                <label style="color: #B3B3B3; font-size: 0.85rem; margin-bottom: 6px; display: block;">Wachtwoord</label>
                <input type="password" id="wachtwoord" name="wachtwoord" placeholder="••••••••"
                       style="width: 100%; background: #2a2a2a; border: 1px solid #444; color: #fff; padding: 12px 14px; border-radius: 6px; box-sizing: border-box;" />
            </div>
            <p id="login-fout" style="color: #E50914; font-size: 0.85rem; display: none;">Vul alle verplichte velden in.</p>
            <button type="submit"
                    style="background: #E50914; color: #ffffff; border: none; padding: 12px; border-radius: 6px; font-weight: 700; font-size: 1rem; cursor: pointer; width: 100%;">
                Inloggen
            </button>
        </form>

        <div style="text-align: center; margin-top: 20px; color: #B3B3B3; font-size: 0.85rem;">
            Nog geen account? <a href="/User/Register" style="color: #E50914; font-weight: 600;">Registreren</a>
        </div>
        <div style="text-align: center; margin-top: 10px;">
            <a href="/User/WachtwoordVergeten" style="color: #B3B3B3; font-size: 0.8rem;">Wachtwoord vergeten?</a>
        </div>
    </div>
</div>

<script>
    function valideerLogin() {
        var email = document.getElementById('email').value;
        var wachtwoord = document.getElementById('wachtwoord').value;
        if (!email || !wachtwoord) {
            document.getElementById('login-fout').style.display = 'block';
            return false;
        }
        return true;
    }
</script>