@model MovieT.ViewModels.UserViewModel

@if (TempData["Melding"] != null)
{
    <p style="color:green">@TempData["Melding"]</p>
}

@if (TempData["Foutmelding"] != null)
{
    <p style="color:red">@TempData["Foutmelding"]</p>
}

<h2>Inloggen</h2>
<form asp-action="Login" method="post">
    <div>
        <label>Gebruikersnaam</label>
        <input name="gebruikersnaam" />
    </div>
    <div>
        <label>Wachtwoord</label>
        <input name="wachtwoord" type="password" />
    </div>
    <button type="submit">Inloggen</button>
</form>