@{
    ViewData["Title"] = "Wachtwoord vergeten";
}

<h2>Wachtwoord vergeten</h2>

@if (TempData["Fout"] != null)
{
    <div class="alert alert-danger">@TempData["Fout"]</div>
}

<form method="post">
    <div class="mb-3">
        <label for="email">E-mailadres</label>
        <input type="email" id="email" name="email" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary">Verstuur reset link</button>
</form>

<a href="@Url.Action("Login", "User")">Terug naar inloggen</a>