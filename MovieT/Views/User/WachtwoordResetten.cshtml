@{
    ViewData["Title"] = "Wachtwoord resetten";
}

<h2>Nieuw wachtwoord instellen</h2>

@if (TempData["Fout"] != null)
{
    <div class="alert alert-danger">@TempData["Fout"]</div>
}

<form method="post">
    <input type="hidden" name="token" value="@ViewBag.Token" />

    <div class="mb-3">
        <label for="nieuwWachtwoord">Nieuw wachtwoord</label>
        <input type="password" id="nieuwWachtwoord" name="nieuwWachtwoord" class="form-control" required />
    </div>
    <div class="mb-3">
        <label for="bevestigWachtwoord">Bevestig wachtwoord</label>
        <input type="password" id="bevestigWachtwoord" name="bevestigWachtwoord" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary">Wachtwoord opslaan</button>
</form>